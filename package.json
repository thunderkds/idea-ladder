{
  "name": "idea-ladder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Idea Ladder v1 app: Hono server, Postgres + pgvector, GitHub OAuth sign-in.",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.tsx",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "tsx scripts/prepare-e2e-db.ts && playwright test",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "db:migrate:down": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down --count Infinity",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
