# Copy to .env and fill in values. Never commit .env.
# Local docker compose database: postgres://postgres:postgres@localhost:54329/idea_ladder
DATABASE_URL=
# GitHub OAuth app (callback URL: http://localhost:3000/auth/github/callback for local dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's own GitHub token for repo reads: fine-grained, public repositories, read-only. Never log or commit it.
GITHUB_APP_TOKEN=
# Inngest Cloud keys. Local dev: leave both empty, set INNGEST_DEV=1 and run `bun run inngest:dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Public origin Inngest calls back (e.g. https://ladder.example). Required in production; never taken from the Host header.
INNGEST_SERVE_ORIGIN=
# At least 32 characters, random (e.g. `openssl rand -base64 48`)
SESSION_SECRET=
# New ladder jobs one learner may start per hour (default 20; joins and cache hits do not count).
START_MAX_NEW_JOBS_PER_HOUR=
# Model A for the repo reader (step pick-core-files): always the Anthropic API back end, never the subscription.
# MODEL_A_ID must have a price in eval/prices.json (the server refuses to start otherwise), e.g. claude-sonnet-5-5.
ANTHROPIC_API_KEY=
MODEL_A_ID=
# Repo reader limits: step cap (default 15) and token budget, input + output tokens (default 80000).
READER_MAX_STEPS=
READER_TOKEN_BUDGET=
# Web Push (VAPID) for daily review reminders: set all three or none (none = reminders off).
# Generate a key pair with `bunx web-push generate-vapid-keys`. The private key is never logged or sent to the client.
# VAPID_SUBJECT is a mailto: address or an https URL the push service can contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional: PORT (default 3000), NODE_ENV (development | test | production),
# GITHUB_OAUTH_BASE_URL (default https://github.com), GITHUB_API_BASE_URL (default https://api.github.com)
