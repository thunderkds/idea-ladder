# Names only. Copy to .env (git-ignored) and fill in the values.
DATABASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
# Optional:
# APP_BASE_URL=http://localhost:3000
# PORT=3000
# GITHUB_OAUTH_BASE_URL=https://github.com
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_APP_TOKEN=            # fine-grained token, public repositories read-only; never logged
# INNGEST_DEV=1                # local only: use the Inngest dev server (pnpm inngest:dev)
# INNGEST_BASE_URL=http://127.0.0.1:8288
# INNGEST_EVENT_KEY=           # production: key for sending events
# INNGEST_SIGNING_KEY=         # production: key that signs requests to /api/inngest
# Repo reader (model A). Without ANTHROPIC_API_KEY and MODEL_A_ID the workflow stops after fetching the repo.
# ANTHROPIC_API_KEY=           # never logged
# MODEL_A_ID=                  # the Claude model id for the reader; its price must be in eval/prices.json
# READER_MAX_STEPS=15          # tool-loop step cap
# READER_TOKEN_BUDGET=80000    # input + output tokens per run, final calls excluded from the stop test
