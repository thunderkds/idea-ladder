# Copy to .env and fill in values. Never commit .env.
# Local docker compose database: postgres://postgres:postgres@localhost:54329/idea_ladder
DATABASE_URL=
# GitHub OAuth app (callback URL: http://localhost:3000/auth/github/callback for local dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's own GitHub token for repo reads: fine-grained, public repositories, read-only. Never log or commit it.
GITHUB_APP_TOKEN=
# Inngest Cloud keys. Local dev: leave both empty, set INNGEST_DEV=1 and run `bun run inngest:dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Public origin Inngest calls back (e.g. https://ladder.example). Required in production; never taken from the Host header.
INNGEST_SERVE_ORIGIN=
# At least 32 characters, random (e.g. `openssl rand -base64 48`)
SESSION_SECRET=
# New ladder jobs one learner may start per hour (default 20; joins and cache hits do not count).
START_MAX_NEW_JOBS_PER_HOUR=
# Model A for the repo reader (step pick-core-files): claude-code (default: `claude -p` on the Claude subscription,
# no API key) or api (Anthropic API, paid).
MODEL_A_BACKEND=
# Optional unless MODEL_A_BACKEND=api. For api, MODEL_A_ID is required and must have a price in eval/prices.json
# (the server refuses to start otherwise), e.g. claude-sonnet-5-5. For claude-code, MODEL_A_ID is an optional
# --model alias or id (unset = the CLI default).
ANTHROPIC_API_KEY=
MODEL_A_ID=
# Model B (the blind solver, T009): a separate Claude call that never sees the answer key. Same two back ends as
# model A: claude-code (default, the Claude subscription, no API key) or api (needs ANTHROPIC_API_KEY and MODEL_B_ID,
# which must have a price in eval/prices.json). For claude-code, MODEL_B_ID is an optional --model alias or id.
# The server logs one warning when model B uses the same model as model A (blind spots are shared).
MODEL_B_BACKEND=
MODEL_B_ID=
# Repo reader limits: step cap (default 15) and token budget, input + output tokens (default 80000).
READER_MAX_STEPS=
READER_TOKEN_BUDGET=
# Near-duplicate cutoff for generated items: word-overlap (Jaccard) similarity, greater than 0 and at most 1
# (default 0.8). DEDUPE_COSINE was removed (T031) and the server refuses to start while it is set.
DEDUPE_JACCARD=
# Web Push (VAPID) for daily review reminders: set all three or none (none = reminders off).
# Generate a key pair with `bunx web-push generate-vapid-keys`. The private key is never logged or sent to the client.
# VAPID_SUBJECT is a mailto: address or an https URL the push service can contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional: PORT (default 3000), NODE_ENV (development | test | production),
# GITHUB_OAUTH_BASE_URL (default https://github.com), GITHUB_API_BASE_URL (default https://api.github.com)
